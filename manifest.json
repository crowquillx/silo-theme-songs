{
  "plugin_id": "dev.crowquillx.theme-songs",
  "version": "0.2.0",
  "checksum": "__CHECKSUM__",
  "silo_api_version": "v1",
  "supported_platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    },
    {
      "os": "linux",
      "arch": "arm64"
    }
  ],
  "presentation": {
    "display_name": "Theme Songs",
    "summary": "Downloads theme songs for movies and series, with season openings and endings for anime from AnimeThemes.",
    "description_markdown": "Downloads theme audio for movies and series from ThemerrDB, and opening and ending themes for anime series from AnimeThemes. Themes are saved as MP3 in each item's `theme-music` folder, and existing themes are never replaced. Theme Songs runs on its own once a day and after Silo scans new items.\n\nAnimeThemes was a separate plugin before version 0.2.0. Uninstall it after installing this version; Theme Songs keeps managing the themes it downloaded.",
    "setup_markdown": "1. Create an API key in **Administration → API Keys**, paste it into **Silo API key** and save.\n2. Open **Theme Songs** in the admin menu. The first run starts shortly after, and the page lets you choose libraries.\n\nSilo writes themes into your media folders, so they must be writable. Silo's Docker Compose file mounts media read-only; remove `:ro` from the media volume and recreate the container. Restart Silo to see **Download Theme Songs** in Scheduled Tasks.",
    "homepage_url": "https://github.com/crowquillx/silo-theme-songs",
    "source_url": "https://github.com/crowquillx/silo-theme-songs",
    "support_url": "https://github.com/crowquillx/silo-theme-songs/issues",
    "changelog_url": "https://github.com/crowquillx/silo-theme-songs/releases",
    "publisher_name": "crowquillx",
    "publisher_url": "https://github.com/crowquillx",
    "license_spdx": "MIT"
  },
  "capabilities": [
    {
      "type": "scheduled_task.v1",
      "id": "sync",
      "display_name": "Download Theme Songs",
      "description": "Downloads movie and series themes. Theme Songs also runs on its own; add triggers here for extra runs."
    },
    {
      "type": "event_consumer.v1",
      "id": "library-scans",
      "display_name": "Theme Songs after library scans",
      "description": "Downloads themes for new items after Silo scans a library.",
      "subscriptions": [
        "scan_complete"
      ]
    },
    {
      "type": "http_routes.v1",
      "id": "status",
      "display_name": "Theme Songs page",
      "description": "Administrator page with libraries, run controls and the last result."
    }
  ],
  "global_config_schema": [
    {
      "key": "settings",
      "title": "Theme Songs settings",
      "description": "Only the API key is required.",
      "json_schema": "{\"type\":\"object\",\"properties\":{\"api_key\":{\"type\":\"string\",\"minLength\":1},\"library_ids\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"string\"}]},\"skip_library_ids\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"string\"}]},\"dry_run\":{\"type\":\"boolean\",\"default\":false},\"anime_themes\":{\"type\":\"boolean\",\"default\":true},\"anime_openings\":{\"type\":\"boolean\",\"default\":true},\"anime_endings\":{\"type\":\"boolean\",\"default\":true},\"anime_spoilers\":{\"type\":\"boolean\",\"default\":false},\"anime_nsfw\":{\"type\":\"boolean\",\"default\":false},\"assisted_search\":{\"type\":\"boolean\",\"default\":false},\"anime_library_ids\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"string\"}]},\"exclude_items\":{\"anyOf\":[{\"type\":\"array\",\"items\":{\"type\":\"string\"}},{\"type\":\"string\"}]},\"max_downloads\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":10000,\"default\":0},\"manage_tools\":{\"type\":\"boolean\",\"default\":true},\"base_url\":{\"type\":\"string\"},\"profile_id\":{\"type\":\"string\"},\"state_dir\":{\"type\":\"string\"},\"ffprobe\":{\"type\":\"string\"},\"destinations\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"allowed_roots\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1},\"path_mappings\":{\"type\":\"array\",\"items\":{\"type\":\"object\",\"properties\":{\"server\":{\"type\":\"string\"},\"local\":{\"type\":\"string\"}},\"required\":[\"server\",\"local\"],\"additionalProperties\":false}},\"single_season_flat_fallback\":{\"type\":\"boolean\",\"default\":false},\"destination_overrides\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"}}},\"additionalProperties\":false},{\"type\":\"string\"}]},\"provider\":{\"anyOf\":[{\"type\":\"object\"},{\"type\":\"string\"}]},\"anime_provider\":{\"anyOf\":[{\"type\":\"object\"},{\"type\":\"string\"}]},\"preview_only\":{\"type\":\"boolean\"},\"manual_refresh\":{\"type\":\"boolean\"},\"source_generation\":{\"type\":\"string\"}},\"required\":[\"api_key\"],\"additionalProperties\":false}",
      "required": false,
      "admin_form": {
        "fields": [
          {
            "key": "api_key",
            "label": "Silo API key",
            "description": "Create one in Administration → API Keys with an administrator account. Theme Songs uses it to read your libraries and to ask Silo to scan each new theme.",
            "control": 3,
            "secret": true,
            "required": true
          },
          {
            "key": "skip_library_ids",
            "label": "Skip these libraries",
            "description": "Library IDs separated by commas. Theme Songs uses every other movie and series library, including ones you add later. The Theme Songs page lists your libraries with checkboxes.",
            "control": 1,
            "placeholder": "None"
          },
          {
            "key": "library_ids",
            "label": "Only these libraries",
            "description": "Library IDs separated by commas. Leave empty to use every movie and series library.",
            "control": 1,
            "placeholder": "All movie and series libraries"
          },
          {
            "key": "dry_run",
            "label": "Dry run",
            "description": "List what would be downloaded on the Theme Songs page without saving any files.",
            "control": 5,
            "default_value": false
          },
          {
            "key": "anime_themes",
            "label": "Use AnimeThemes for anime",
            "description": "Series that AnimeThemes knows get their openings and endings in each season folder. Other series and all movies use ThemerrDB.",
            "control": 5,
            "default_value": true
          },
          {
            "key": "anime_openings",
            "label": "Anime openings",
            "control": 5,
            "default_value": true,
            "show_when": [
              {
                "field": "anime_themes",
                "equals": [
                  "true"
                ]
              }
            ]
          },
          {
            "key": "anime_endings",
            "label": "Anime endings",
            "control": 5,
            "default_value": true,
            "show_when": [
              {
                "field": "anime_themes",
                "equals": [
                  "true"
                ]
              }
            ]
          },
          {
            "key": "anime_spoilers",
            "label": "Allow anime themes marked as spoilers",
            "control": 5,
            "default_value": false,
            "show_when": [
              {
                "field": "anime_themes",
                "equals": [
                  "true"
                ]
              }
            ]
          },
          {
            "key": "anime_nsfw",
            "label": "Allow anime themes marked as NSFW",
            "control": 5,
            "default_value": false,
            "show_when": [
              {
                "field": "anime_themes",
                "equals": [
                  "true"
                ]
              }
            ]
          },
          {
            "key": "assisted_search",
            "label": "Suggest YouTube matches",
            "description": "When ThemerrDB has no theme for an item, search YouTube and list candidates on the Theme Songs page. Nothing is downloaded until you save a URL for the item.",
            "control": 5,
            "default_value": false
          },
          {
            "key": "anime_library_ids",
            "label": "AnimeThemes libraries",
            "description": "Library IDs separated by commas. Leave empty to check every series library for anime.",
            "control": 1,
            "placeholder": "All series libraries"
          },
          {
            "key": "exclude_items",
            "label": "Skip these items",
            "description": "Catalog item IDs separated by commas.",
            "control": 2,
            "placeholder": "None"
          },
          {
            "key": "max_downloads",
            "label": "Downloads per run",
            "description": "0 means no limit.",
            "control": 4,
            "default_value": 0,
            "validation": {
              "has_min": true,
              "min": 0,
              "has_max": true,
              "max": 10000
            }
          },
          {
            "key": "manage_tools",
            "label": "Install yt-dlp and Deno",
            "description": "The first theme that comes from YouTube installs them in the plugin's state directory, which uses about 190 MB. Turn off to use your own from PATH.",
            "control": 5,
            "default_value": true
          },
          {
            "key": "base_url",
            "label": "Silo URL",
            "description": "Needed only when the plugin cannot reach Silo at its internal address.",
            "control": 1,
            "placeholder": "Silo's internal address"
          },
          {
            "key": "profile_id",
            "label": "Profile ID",
            "control": 1,
            "placeholder": "The API key owner's primary profile"
          },
          {
            "key": "state_dir",
            "label": "Persistent state directory",
            "description": "Needed only when Silo installs plugins outside its plugin directory.",
            "control": 1,
            "placeholder": "plugin-state in Silo's plugin directory"
          },
          {
            "key": "ffprobe",
            "label": "ffprobe path",
            "control": 1,
            "placeholder": "/usr/lib/jellyfin-ffmpeg/ffprobe, then PATH"
          },
          {
            "key": "destinations",
            "label": "Writable roots and path mappings (JSON)",
            "description": "Needed only when the plugin sees media at other paths than Silo. The README describes the format.",
            "control": 2
          },
          {
            "key": "provider",
            "label": "ThemerrDB and YouTube settings (JSON)",
            "description": "Per-item URL overrides and the other options in the README.",
            "control": 2
          },
          {
            "key": "anime_provider",
            "label": "AnimeThemes settings (JSON)",
            "description": "Manual mappings, selection overrides and the other options in the README.",
            "control": 2
          }
        ],
        "sections": [
          {
            "key": "connection",
            "title": "Connection",
            "field_keys": [
              "api_key"
            ]
          },
          {
            "key": "libraries",
            "title": "Libraries",
            "field_keys": [
              "skip_library_ids",
              "library_ids"
            ]
          },
          {
            "key": "downloads",
            "title": "Downloads",
            "field_keys": [
              "dry_run",
              "anime_themes",
              "anime_openings",
              "anime_endings",
              "anime_spoilers",
              "anime_nsfw",
              "assisted_search"
            ]
          },
          {
            "key": "advanced",
            "title": "Advanced",
            "description": "Leave these empty unless your setup differs from Silo's Docker image.",
            "collapsible": true,
            "collapsed_default": true,
            "field_keys": [
              "anime_library_ids",
              "exclude_items",
              "max_downloads",
              "manage_tools",
              "base_url",
              "profile_id",
              "state_dir",
              "ffprobe",
              "destinations",
              "provider",
              "anime_provider"
            ]
          }
        ]
      }
    }
  ],
  "http_routes": [
    {
      "id": "status-page",
      "method": "GET",
      "path": "/",
      "access": "admin",
      "navigable": true,
      "navigation_label": "Theme Songs",
      "navigation_kind": "admin"
    },
    {
      "id": "status-json",
      "method": "GET",
      "path": "/status",
      "access": "admin"
    },
    {
      "id": "run",
      "method": "POST",
      "path": "/run",
      "access": "admin"
    },
    {
      "id": "libraries",
      "method": "POST",
      "path": "/libraries",
      "access": "admin"
    }
  ],
  "metadata": {
    "configuration_check": true
  }
}
